{
  "id": "signal",
  "label": "Signal",
  "extends": null,
  "verified": "2026-07-21",
  "limits": {
    "message": 2000
  },
  "link": {
    "style": "none"
  },
  "escape": {
    "mechanism": "none",
    "chars": ""
  },
  "nodes": {
    "paragraph": {
      "support": "native"
    },
    "heading": {
      "support": "none",
      "fallback": "inline",
      "template": "{content}"
    },
    "code_block": {
      "support": "native",
      "open": "",
      "close": ""
    },
    "block_quote": {
      "support": "native",
      "prefix": "> "
    },
    "list": {
      "support": "native",
      "bullet": "- ",
      "ordered": "{number}. "
    },
    "list_item": {
      "support": "native"
    },
    "table": {
      "support": "none",
      "fallback": "codeblock"
    },
    "table_row": {
      "support": "none",
      "fallback": "unwrap"
    },
    "table_cell": {
      "support": "none",
      "fallback": "unwrap"
    },
    "thematic_break": {
      "support": "none",
      "fallback": "unwrap"
    },
    "div": {
      "support": "none",
      "fallback": "unwrap"
    },
    "raw_block": {
      "support": "none",
      "fallback": "drop"
    },
    "footnote": {
      "support": "none",
      "fallback": "appendix"
    },
    "definition_list": {
      "support": "none",
      "fallback": "unwrap"
    },
    "definition_term": {
      "support": "none",
      "fallback": "unwrap"
    },
    "definition_description": {
      "support": "none",
      "fallback": "unwrap"
    },
    "section": {
      "support": "none",
      "fallback": "unwrap"
    },
    "line_block": {
      "support": "none",
      "fallback": "unwrap"
    },
    "comment": {
      "support": "none",
      "fallback": "drop"
    },
    "figure": {
      "support": "none",
      "fallback": "unwrap"
    },
    "caption": {
      "support": "none",
      "fallback": "unwrap"
    },
    "text": {
      "support": "native"
    },
    "emphasis": {
      "support": "none",
      "fallback": "unwrap"
    },
    "strong": {
      "support": "none",
      "fallback": "unwrap"
    },
    "underline": {
      "support": "none",
      "fallback": "unwrap"
    },
    "strike": {
      "support": "none",
      "fallback": "unwrap"
    },
    "inline_extension": {
      "support": "none",
      "fallback": "unwrap"
    },
    "mention": {
      "support": "none",
      "fallback": "unwrap"
    },
    "code": {
      "support": "none",
      "fallback": "unwrap"
    },
    "link": {
      "support": "none",
      "fallback": "inline",
      "template": "{content} ({url})"
    },
    "image": {
      "support": "none",
      "fallback": "inline",
      "template": "{alt} ({url})"
    },
    "soft_break": {
      "support": "native"
    },
    "hard_break": {
      "support": "native"
    },
    "raw_inline": {
      "support": "none",
      "fallback": "drop"
    },
    "escaped_text": {
      "support": "native"
    },
    "footnote_ref": {
      "support": "native"
    },
    "inline_footnote": {
      "support": "none",
      "fallback": "appendix"
    },
    "heading_ref": {
      "support": "none",
      "fallback": "unwrap"
    },
    "span": {
      "support": "none",
      "fallback": "unwrap"
    },
    "superscript": {
      "support": "none",
      "fallback": "unwrap"
    },
    "subscript": {
      "support": "none",
      "fallback": "unwrap"
    },
    "highlight": {
      "support": "none",
      "fallback": "unwrap"
    },
    "insert": {
      "support": "none",
      "fallback": "unwrap"
    },
    "delete": {
      "support": "none",
      "fallback": "unwrap"
    },
    "symbol": {
      "support": "native"
    },
    "math": {
      "support": "none",
      "fallback": "inline",
      "template": "{content}"
    },
    "abbreviation": {
      "support": "none",
      "fallback": "unwrap"
    }
  }
}
